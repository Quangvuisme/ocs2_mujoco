  <!-- Unitree G1, 12 actuated leg joints (waist and arms fixed). Converted from
       https://github.com/cyugai/g1_control (g1_legged_description/mjcf/g1_legged_control_.xml).
       Visual meshes: group 2, collision geometry: group 3. Feet: 4 small spheres per sole,
       toe / heel sites at the OCS2 contact points (l_foot_toe, l_foot_heel, r_foot_toe, r_foot_heel). -->
  <compiler angle="radian" meshdir="meshes" autolimits="true"/>

  <option timestep="0.001" cone="elliptic" impratio="10" solver="Newton" iterations="50"/>

  <default>
    <default class="g1">
      <joint damping="0.5" armature="0.01" frictionloss="0.1"/>
      <site size="0.01" rgba="1 0 0 0.5" group="4"/>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2" density="0"/>
      </default>
      <default class="collision">
        <!-- contype 2 / conaffinity 1: collides with the scene, never with itself -->
        <geom group="3" contype="2" conaffinity="1" rgba="0.7 0.7 0.7 0.3"/>
        <default class="foot">
          <geom type="sphere" size="0.005" priority="1" condim="3" friction="1.0 0.02 0.01" rgba="0.2 0.2 0.2 1"/>
        </default>
      </default>
    </default>
  </default>

