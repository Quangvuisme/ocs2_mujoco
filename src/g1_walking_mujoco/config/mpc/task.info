centroidalModelType             1      // 0: FullCentroidalDynamics, 1: Single Rigid Body Dynamics

g1_interface
{
  verbose                               false  // show the loaded parameters
  contactHeight                         0.005  // [m] contact frames (toe / heel sphere centres) above the ground in stance
}

model_settings
{
  positionErrorGain             20.0   ; swing foot z tracks the spline (position + velocity)
  phaseTransitionStanceTime     0.4

  verboseCppAd                  true
  recompileLibrariesCppAd       true   ; set false to reuse the generated libraries (faster start-up)
  modelFolderCppAd              /tmp/g1_walking_mujoco
}

swing_trajectory_config
{
  liftOffVelocity               0.05
  touchDownVelocity            -0.10
  swingHeight                   0.08   ; swing apex above the ground [m]
  swingTimeScale                0.15
}

controller
{
  standUpKp                     200.0  ; [Nm/rad] PD stand-up
  standUpKd                     5.0
  standUpDuration               1.0    ; [s]
  wbcJointKp                    400.0  ; acceleration-level joint PD of the RNEA whole-body control
  wbcJointKd                    40.0
  commandHorizon                1.0    ; [s]
  maxCommandLead                0.10   ; [m] integrated walking command stays within this of the base (0: no position feedback)
  maxCommandYawLead             0.20   ; [rad]
}

; DDP settings
ddp
{
  algorithm                       SLQ

  nThreads                        3
  threadPriority                  50

  maxNumIterations                1
  minRelCost                      1e-1
  constraintTolerance             5e-3

  displayInfo                     false
  displayShortSummary             false
  checkNumericalStability         false
  debugPrintRollout               false

  AbsTolODE                       1e-5
  RelTolODE                       1e-3
  maxNumStepsPerSecond            10000
  timeStep                        0.015
  backwardPassIntegratorType      ODE45

  constraintPenaltyInitialValue   20.0
  constraintPenaltyIncreaseRate   2.0

  preComputeRiccatiTerms          true

  useFeedbackPolicy               false

  strategy                        LINE_SEARCH
  lineSearch
  {
    minStepLength                 1e-2
    maxStepLength                 1.0
    hessianCorrectionStrategy     DIAGONAL_SHIFT
    hessianCorrectionMultiple     1e-5
  }
}

; Rollout settings
rollout
{
  AbsTolODE                       1e-5
  RelTolODE                       1e-3
  timeStep                        0.015
  integratorType                  ODE45
  maxNumStepsPerSecond            10000
  checkNumericalStability         false
}

mpc
{
  timeHorizon                     1.0  ; [s]
  solutionTimeWindow              -1   ; maximum [s]
  coldStart                       false

  debugPrint                      false

  mpcDesiredFrequency             100 ; [Hz]
  mrtDesiredFrequency             400 ; [Hz]
}

initialState
{
   ;; Normalized Centroidal Momentum: [linear, angular] ;;
   (0,0)  0.0     ; vcom_x
   (1,0)  0.0     ; vcom_y
   (2,0)  0.0     ; vcom_z
   (3,0)  0.0     ; L_x / robotMass
   (4,0)  0.0     ; L_y / robotMass
   (5,0)  0.0     ; L_z / robotMass

   ;; Base Pose: [position, orientation] ;;
   (6,0)  0.0     ; p_base_x
   (7,0)  0.0     ; p_base_y
   (8,0)  0.73    ; p_base_z (pelvis)
   (9,0)  0.0     ; theta_base_z
   (10,0) 0.0     ; theta_base_y
   (11,0) 0.0     ; theta_base_x

   ;; Leg Joint Positions: [left leg, right leg] ;;
   (12,0) -0.40   ; left_hip_pitch_joint
   (13,0)  0.00   ; left_hip_roll_joint
   (14,0)  0.00   ; left_hip_yaw_joint
   (15,0)  0.87   ; left_knee_joint
   (16,0) -0.47   ; left_ankle_pitch_joint  (flat sole: hip + knee + ankle = 0)
   (17,0)  0.00   ; left_ankle_roll_joint
   (18,0) -0.40   ; right_hip_pitch_joint
   (19,0)  0.00   ; right_hip_roll_joint
   (20,0)  0.00   ; right_hip_yaw_joint
   (21,0)  0.87   ; right_knee_joint
   (22,0) -0.47   ; right_ankle_pitch_joint
   (23,0)  0.00   ; right_ankle_roll_joint
}

; standard state weight matrix
Q
{
  scaling 1e+0

  ;; Normalized Centroidal Momentum: [linear, angular] ;;
  (0,0)   15.0     ; vcom_x
  (1,1)   15.0     ; vcom_y
  (2,2)   30.0     ; vcom_z
  (3,3)   5.0      ; L_x / robotMass
  (4,4)   10.0     ; L_y / robotMass
  (5,5)   10.0     ; L_z / robotMass

  ;; Base Pose: [position, orientation] ;;
  (6,6)   1000.0   ; p_base_x
  (7,7)   1000.0   ; p_base_y
  (8,8)   500.0    ; p_base_z
  (9,9)   200.0    ; theta_base_z
  (10,10) 2000.0   ; theta_base_y
  (11,11) 2000.0   ; theta_base_x

  ;; Leg Joint Positions: [left leg, right leg] ;;
  (12,12) 50.0     ; left_hip_pitch_joint
  (13,13) 400.0    ; left_hip_roll_joint
  (14,14) 250.0    ; left_hip_yaw_joint
  (15,15) 30.0     ; left_knee_joint
  (16,16) 150.0    ; left_ankle_pitch_joint
  (17,17) 10.0     ; left_ankle_roll_joint
  (18,18) 50.0     ; right_hip_pitch_joint
  (19,19) 400.0    ; right_hip_roll_joint
  (20,20) 250.0    ; right_hip_yaw_joint
  (21,21) 30.0     ; right_knee_joint
  (22,22) 150.0    ; right_ankle_pitch_joint
  (23,23) 10.0     ; right_ankle_roll_joint
}

; control weight matrix
R
{
  scaling 1e-3

  ;; Contact Forces: [l_foot_toe, r_foot_toe, l_foot_heel, r_foot_heel] ;;
  (0,0)   4.0       ; x
  (1,1)   4.0       ; y
  (2,2)   4.0       ; z
  (3,3)   4.0       ; x
  (4,4)   4.0       ; y
  (5,5)   4.0       ; z
  (6,6)   4.0       ; x
  (7,7)   4.0       ; y
  (8,8)   4.0       ; z
  (9,9)   4.0       ; x
  (10,10) 4.0       ; y
  (11,11) 4.0       ; z

  ;; contact point velocity relative to the base (uses the Jacobian at the nominal configuration) ;;
  (12,12) 2000.0    ; x
  (13,13) 4000.0    ; y
  (14,14) 2000.0    ; z
  (15,15) 2000.0    ; x
  (16,16) 4000.0    ; y
  (17,17) 2000.0    ; z
  (18,18) 2000.0    ; x
  (19,19) 4000.0    ; y
  (20,20) 2000.0    ; z
  (21,21) 2000.0    ; x
  (22,22) 4000.0    ; y
  (23,23) 2000.0    ; z
}

frictionConeSoftConstraint
{
  frictionCoefficient    0.7

  ; relaxed log barrier parameters
  mu                     0.1
  delta                  5.0
}
